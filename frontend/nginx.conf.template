# ════════════════════════════════════════════════════════════════════════════
#  VYLAPP FRONTEND — nginx reverse proxy config
#
#  Mirrors the Vite dev-server proxy so the same /api and /socket.io paths
#  work in production without any code changes in the frontend.
#
#  BACKEND_URL is injected at container start by the Dockerfile entrypoint
#  via `envsubst` — do not hardcode the URL here.
#
#  Proxy table:
#    /api/*        → ${BACKEND_URL}/*          (REST API, strips /api prefix)
#    /socket.io/*  → ${BACKEND_URL}/socket.io/* (WebSocket upgrade)
#    everything else → /index.html              (React SPA catch-all)
# ════════════════════════════════════════════════════════════════════════════

server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # ── Gzip ────────────────────────────────────────────────────────────────
    gzip on;
    gzip_types text/plain text/css application/json application/javascript
               text/xml application/xml application/xml+rss text/javascript
               image/svg+xml;
    gzip_min_length 1024;

    # ── Static assets (long cache) ───────────────────────────────────────────
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # ── REST API proxy  (/api/* → backend, strips /api prefix) ───────────────
    location /api/ {
        proxy_pass         ${BACKEND_URL}/;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_read_timeout 90s;
    }

    # ── WebSocket proxy (/socket.io → backend) ───────────────────────────────
    location /socket.io/ {
        proxy_pass         ${BACKEND_URL}/socket.io/;
        proxy_http_version 1.1;
        proxy_set_header   Upgrade    $http_upgrade;
        proxy_set_header   Connection "upgrade";
        proxy_set_header   Host       $host;
        proxy_read_timeout 86400s;  # keep WS connections alive
    }

    # ── React SPA catch-all ──────────────────────────────────────────────────
    location / {
        try_files $uri $uri/ /index.html;
    }
}
