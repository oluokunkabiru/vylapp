# ── Server ──
PORT=4000
NODE_ENV=development

# ── Database (PostgreSQL) ──
DATABASE_URL=postgresql://vylapp:vylapp_dev_pw@localhost:5432/vylapp
PGSSL=false

# ── Auth secrets (generate real random strings in production) ──
JWT_SECRET=change_this_to_a_long_random_string
REFRESH_SECRET=change_this_to_a_different_long_random_string

# ── CORS ── one origin, or a comma-separated list to allow more than one
# frontend (e.g. apex + www, or prod + a staging domain):
#   CLIENT_ORIGIN=https://vylapp.com,https://www.vylapp.com
# The first entry is also used as the single canonical URL for OAuth
# redirects and email links (verify-email, reset-password, etc).
CLIENT_ORIGIN=http://localhost:5173

# ── Optional: only needed if you want AI-quality translation/autopilot
# instead of the built-in organic dictionary + template engine.
# Leave blank to run fully offline with zero external dependencies. ──
ANTHROPIC_API_KEY=

# ── Phone + one-time-code sign-in (I-02) ──
# "mock" needs no SMS account at all — it always issues OTP_MOCK_CODE and
# logs it server-side, so phone sign-in fully works with zero setup. Switch
# to "twilio" and fill in the three TWILIO_* values once a real account
# exists; nothing else about the feature changes.
OTP_PROVIDER=mock
OTP_MOCK_CODE=123456
OTP_TTL_MINUTES=10
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ── Public base URL of THIS backend (used to build OAuth redirect_uri) ────────
API_BASE_URL=http://localhost:4000

# ── Social sign-in (OAuth) — leave a provider blank to hide it from login ─────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# ── Firebase Admin SDK (server-side FCM push for chat notifications) ─────────
# From Firebase console → Project Settings → Service accounts → Generate new private key.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
