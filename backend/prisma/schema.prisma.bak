model paid_dm_access {
  id                                     String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  payer_id                               String    @db.Uuid
  creator_id                             String    @db.Uuid
  amount_usd                             Decimal   @db.Decimal(8, 2)
  stripe_payment_intent_id               String?
  expires_at                             DateTime? @db.Timestamptz(6)
  created_at                             DateTime  @default(now()) @db.Timestamptz(6)
  users_paid_dm_access_creator_idTousers users     @relation("paid_dm_access_creator_idTousers", fields: [creator_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users_paid_dm_access_payer_idTousers   users     @relation("paid_dm_access_payer_idTousers", fields: [payer_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model password_resets {
  id         String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id    String    @db.Uuid
  token      String    @unique
  expires_at DateTime  @db.Timestamptz(6)
  used_at    DateTime? @db.Timestamptz(6)
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model path_courses {
  path_id        String         @db.Uuid
  course_id      String         @db.Uuid
  sort_order     Int            @default(0)
  is_required    Boolean        @default(true)
  courses        courses        @relation(fields: [course_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  learning_paths learning_paths @relation(fields: [path_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([path_id, course_id])
}

model path_enrolments {
  user_id        String         @db.Uuid
  path_id        String         @db.Uuid
  enrolled_at    DateTime       @default(now()) @db.Timestamptz(6)
  completed_at   DateTime?      @db.Timestamptz(6)
  learning_paths learning_paths @relation(fields: [path_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users          users          @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([user_id, path_id])
  @@index([user_id], map: "idx_path_enrolments_user")
}

model permissions {
  id                   String                 @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name                 String                 @unique
  guard                String                 @default("web")
  description          String?
  group_name           String?
  created_at           DateTime               @default(now()) @db.Timestamptz(6)
  role_has_permissions role_has_permissions[]
  user_has_permissions user_has_permissions[]
}

model platform_metrics_hourly {
  id              String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  snapshot_at     DateTime @default(now()) @db.Timestamptz(6)
  active_users    Int      @default(0)
  new_users       Int      @default(0)
  vibes_posted    Int      @default(0)
  spaces_live     Int      @default(0)
  space_listeners Int      @default(0)
  messages_sent   Int      @default(0)
  revenue_usd     Decimal  @default(0) @db.Decimal(12, 2)

  @@index([snapshot_at(sort: Desc)], map: "idx_platform_metrics_time")
}

model platform_subscriptions {
  id                     String              @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id                String              @db.Uuid
  plan                   subscription_plan
  status                 subscription_status @default(active)
  price_usd              Decimal             @db.Decimal(8, 2)
  billing_period         String              @default("monthly")
  stripe_subscription_id String?             @unique
  stripe_customer_id     String?
  trial_ends_at          DateTime?           @db.Timestamptz(6)
  current_period_start   DateTime?           @db.Timestamptz(6)
  current_period_end     DateTime?           @db.Timestamptz(6)
  cancelled_at           DateTime?           @db.Timestamptz(6)
  cancellation_reason    String?
  created_at             DateTime            @default(now()) @db.Timestamptz(6)
  updated_at             DateTime            @default(now()) @db.Timestamptz(6)
  users                  users               @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model push_tokens {
  id          String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id     String   @db.Uuid
  token       String   @unique
  platform    String
  device_name String?
  active      Boolean  @default(true)
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  updated_at  DateTime @default(now()) @db.Timestamptz(6)
  users       users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id], map: "idx_push_tokens_user", where: raw("(active = true)"))
}

model refresh_tokens {
  id          String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id     String    @db.Uuid
  token       String    @unique
  device_info Json?
  expires_at  DateTime  @db.Timestamptz(6)
  revoked_at  DateTime? @db.Timestamptz(6)
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  users       users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([expires_at], map: "idx_refresh_tokens_expiry", where: raw("(revoked_at IS NULL)"))
  @@index([token], map: "idx_refresh_tokens_token")
  @@index([user_id], map: "idx_refresh_tokens_user")
}

model reports {
  id                                    String               @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  reporter_id                           String               @db.Uuid
  reported_vibe_id                      String?              @db.Uuid
  reported_user_id                      String?              @db.Uuid
  reported_space_id                     String?              @db.Uuid
  reported_message_id                   String?              @db.Uuid
  reason                                report_reason
  detail                                String?
  status                                report_status        @default(pending)
  reviewed_by                           String?              @db.Uuid
  reviewed_at                           DateTime?            @db.Timestamptz(6)
  action_taken                          String?
  created_at                            DateTime             @default(now()) @db.Timestamptz(6)
  moderation_actions                    moderation_actions[]
  messages                              messages?            @relation(fields: [reported_message_id], references: [id], onUpdate: NoAction)
  spaces                                spaces?              @relation(fields: [reported_space_id], references: [id], onUpdate: NoAction)
  users_reports_reported_user_idTousers users?               @relation("reports_reported_user_idTousers", fields: [reported_user_id], references: [id], onUpdate: NoAction)
  vibes                                 vibes?               @relation(fields: [reported_vibe_id], references: [id], onUpdate: NoAction)
  users_reports_reporter_idTousers      users                @relation("reports_reporter_idTousers", fields: [reporter_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users_reports_reviewed_byTousers      users?               @relation("reports_reviewed_byTousers", fields: [reviewed_by], references: [id], onUpdate: NoAction)

  @@index([reporter_id], map: "idx_reports_reporter")
  @@index([status, created_at(sort: Desc)], map: "idx_reports_status")
}

model role_has_permissions {
  role_id       String      @db.Uuid
  permission_id String      @db.Uuid
  permissions   permissions @relation(fields: [permission_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  roles         roles       @relation(fields: [role_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([role_id, permission_id])
  @@index([permission_id], map: "idx_rhp_permission")
  @@index([role_id], map: "idx_rhp_role")
}

model roles {
  id                   String                 @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name                 String                 @unique
  guard                String                 @default("web")
  description          String?
  is_system            Boolean                @default(false)
  created_at           DateTime               @default(now()) @db.Timestamptz(6)
  updated_at           DateTime               @default(now()) @db.Timestamptz(6)
  role_has_permissions role_has_permissions[]
  user_has_roles       user_has_roles[]
}

model saved_searches {
  id         String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id    String   @db.Uuid
  query      String
  created_at DateTime @default(now()) @db.Timestamptz(6)
  users      users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model schema_migrations {
  filename   String   @id
  applied_at DateTime @default(now()) @db.Timestamptz(6)
}

model search_history {
  id          String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id     String   @db.Uuid
  query       String
  result_type String?
  clicked_id  String?  @db.Uuid
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  users       users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model space_cohosts {
  space_id     String    @db.Uuid
  user_id      String    @db.Uuid
  status       String    @default("invited")
  invited_at   DateTime  @default(now()) @db.Timestamptz(6)
  responded_at DateTime? @db.Timestamptz(6)
  spaces       spaces    @relation(fields: [space_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users        users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([space_id, user_id])
}

model space_participant_history {
  id               String     @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  space_id         String     @db.Uuid
  user_id          String     @db.Uuid
  role             space_role
  joined_at        DateTime   @db.Timestamptz(6)
  left_at          DateTime?  @db.Timestamptz(6)
  duration_seconds Int?
  created_at       DateTime   @default(now()) @db.Timestamptz(6)
  spaces           spaces     @relation(fields: [space_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users            users      @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model space_participants {
  space_id      String     @db.Uuid
  user_id       String     @db.Uuid
  role          space_role @default(listener)
  joined_at     DateTime   @default(now()) @db.Timestamptz(6)
  left_at       DateTime?  @db.Timestamptz(6)
  was_speaker   Boolean    @default(false)
  tip_total_usd Decimal    @default(0) @db.Decimal(10, 2)
  spaces        spaces     @relation(fields: [space_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users         users      @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([space_id, user_id])
  @@index([space_id], map: "idx_space_participants_space")
  @@index([user_id], map: "idx_space_participants_user")
}

model space_reminders {
  space_id   String   @db.Uuid
  user_id    String   @db.Uuid
  notified   Boolean  @default(false)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  spaces     spaces   @relation(fields: [space_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users      users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([space_id, user_id])
  @@index([space_id], map: "idx_space_reminders_space")
  @@index([user_id], map: "idx_space_reminders_user")
}

model space_speaker_requests {
  id          String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  space_id    String    @db.Uuid
  user_id     String    @db.Uuid
  status      String    @default("pending")
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  resolved_at DateTime? @db.Timestamptz(6)
  spaces      spaces    @relation(fields: [space_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users       users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model space_tickets {
  id                       String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  space_id                 String    @db.Uuid
  user_id                  String    @db.Uuid
  price_usd                Decimal   @db.Decimal(8, 2)
  stripe_payment_intent_id String?
  purchased_at             DateTime  @default(now()) @db.Timestamptz(6)
  refunded_at              DateTime? @db.Timestamptz(6)
  spaces                   spaces    @relation(fields: [space_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users                    users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model space_tips {
  id                                   String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  space_id                             String   @db.Uuid
  tipper_id                            String   @db.Uuid
  recipient_id                         String   @db.Uuid
  amount_usd                           Decimal  @db.Decimal(8, 2)
  message                              String?
  stripe_payment_intent_id             String?
  created_at                           DateTime @default(now()) @db.Timestamptz(6)
  users_space_tips_recipient_idTousers users    @relation("space_tips_recipient_idTousers", fields: [recipient_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  spaces                               spaces   @relation(fields: [space_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users_space_tips_tipper_idTousers    users    @relation("space_tips_tipper_idTousers", fields: [tipper_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([recipient_id, created_at(sort: Desc)], map: "idx_space_tips_recipient")
  @@index([space_id, created_at(sort: Desc)], map: "idx_space_tips_space")
}

model spaces {
  id                        String                      @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  host_id                   String                      @db.Uuid
  title                     String
  description               String?
  category                  feed_category               @default(GENERAL)
  tags                      String[]                    @default([])
  color                     String?                     @default("#7C3AED")
  is_video                  Boolean                     @default(false)
  is_recorded               Boolean                     @default(false)
  is_ticketed               Boolean                     @default(false)
  ticket_price_usd          Decimal?                    @db.Decimal(8, 2)
  is_subscription_only      Boolean                     @default(false)
  is_close_friends          Boolean                     @default(false)
  status                    space_status                @default(scheduled)
  scheduled_for             DateTime?                   @db.Timestamptz(6)
  started_at                DateTime?                   @db.Timestamptz(6)
  ended_at                  DateTime?                   @db.Timestamptz(6)
  duration_seconds          Int?
  listeners_count           Int                         @default(0)
  peak_listeners            Int                         @default(0)
  speakers_count            Int                         @default(0)
  total_tips_usd            Decimal                     @default(0) @db.Decimal(10, 2)
  recording_url             String?
  recording_size_bytes      BigInt?
  transcript_url            String?
  translation_enabled       Boolean                     @default(false)
  languages                 String[]                    @default([])
  created_at                DateTime                    @default(now()) @db.Timestamptz(6)
  updated_at                DateTime                    @default(now()) @db.Timestamptz(6)
  conversations             conversations[]
  messages                  messages[]
  notifications             notifications[]
  reports                   reports[]
  space_cohosts             space_cohosts[]
  space_participant_history space_participant_history[]
  space_participants        space_participants[]
  space_reminders           space_reminders[]
  space_speaker_requests    space_speaker_requests[]
  space_tickets             space_tickets[]
  space_tips                space_tips[]
  users                     users                       @relation(fields: [host_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  super_vibes               super_vibes[]

  @@index([host_id], map: "idx_spaces_host")
  @@index([listeners_count(sort: Desc)], map: "idx_spaces_live", where: raw("(status = 'live'::space_status)"))
  @@index([scheduled_for], map: "idx_spaces_scheduled", where: raw("(status = 'scheduled'::space_status)"))
  @@index([status, created_at(sort: Desc)], map: "idx_spaces_status")
}

model sticker_packs {
  id          String     @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name        String
  preview_url String?
  is_default  Boolean    @default(false)
  is_premium  Boolean    @default(false)
  created_at  DateTime   @default(now()) @db.Timestamptz(6)
  stickers    stickers[]
}

model stickers {
  id            String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  pack_id       String        @db.Uuid
  key           String
  url           String
  tags          String[]      @default([])
  sort_order    Int           @default(0)
  created_at    DateTime      @default(now()) @db.Timestamptz(6)
  sticker_packs sticker_packs @relation(fields: [pack_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model super_vibes {
  id                                    String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  sender_id                             String   @db.Uuid
  recipient_id                          String   @db.Uuid
  vibe_id                               String?  @db.Uuid
  space_id                              String?  @db.Uuid
  amount_usd                            Decimal  @db.Decimal(8, 2)
  emoji                                 String?  @default("⚡")
  message                               String?
  stripe_payment_intent_id              String?
  platform_fee_usd                      Decimal  @db.Decimal(8, 2)
  creator_net_usd                       Decimal  @db.Decimal(8, 2)
  created_at                            DateTime @default(now()) @db.Timestamptz(6)
  users_super_vibes_recipient_idTousers users    @relation("super_vibes_recipient_idTousers", fields: [recipient_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users_super_vibes_sender_idTousers    users    @relation("super_vibes_sender_idTousers", fields: [sender_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  spaces                                spaces?  @relation(fields: [space_id], references: [id], onUpdate: NoAction)
  vibes                                 vibes?   @relation(fields: [vibe_id], references: [id], onUpdate: NoAction)

  @@index([recipient_id, created_at(sort: Desc)], map: "idx_super_vibes_recipient")
  @@index([vibe_id], map: "idx_super_vibes_vibe", where: raw("(vibe_id IS NOT NULL)"))
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model thread_replies {
  id                   String           @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  thread_id            String           @db.Uuid
  author_id            String           @db.Uuid
  parent_reply_id      String?          @db.Uuid
  body                 String
  language             String           @default("en")
  depth                Int              @default(0)
  vote_score           Int              @default(0)
  is_accepted          Boolean          @default(false)
  is_removed           Boolean          @default(false)
  moderation_note      String?
  created_at           DateTime         @default(now()) @db.Timestamptz(6)
  updated_at           DateTime         @default(now()) @db.Timestamptz(6)
  forum_votes          forum_votes[]
  users                users            @relation(fields: [author_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  thread_replies       thread_replies?  @relation("thread_repliesTothread_replies", fields: [parent_reply_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  other_thread_replies thread_replies[] @relation("thread_repliesTothread_replies")
  forum_threads        forum_threads    @relation(fields: [thread_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([thread_id, is_accepted], map: "idx_replies_accepted", where: raw("(is_accepted = true)"))
  @@index([author_id], map: "idx_replies_author")
  @@index([parent_reply_id], map: "idx_replies_parent")
  @@index([thread_id, depth, vote_score(sort: Desc)], map: "idx_replies_thread")
}

model thread_tags {
  thread_id     String        @db.Uuid
  tag_id        String        @db.Uuid
  forum_tags    forum_tags    @relation(fields: [tag_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  forum_threads forum_threads @relation(fields: [thread_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([thread_id, tag_id])
  @@index([tag_id], map: "idx_thread_tags_tag")
}

model transactions {
  id                                        String           @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id                                   String           @db.Uuid
  counterparty_id                           String?          @db.Uuid
  type                                      transaction_type
  direction                                 String
  amount_usd                                Decimal          @db.Decimal(10, 2)
  platform_fee_usd                          Decimal          @default(0) @db.Decimal(10, 2)
  net_usd                                   Decimal          @db.Decimal(10, 2)
  currency                                  String           @default("USD")
  stripe_payment_intent_id                  String?
  stripe_charge_id                          String?
  stripe_transfer_id                        String?
  description                               String?
  metadata                                  Json?            @default("{}")
  status                                    String           @default("completed")
  created_at                                DateTime         @default(now()) @db.Timestamptz(6)
  users_transactions_counterparty_idTousers users?           @relation("transactions_counterparty_idTousers", fields: [counterparty_id], references: [id], onUpdate: NoAction)
  users_transactions_user_idTousers         users            @relation("transactions_user_idTousers", fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id, created_at(sort: Desc)], map: "idx_transactions_user")
}

model translation_usage {
  user_id String   @db.Uuid
  day     DateTime @default(dbgenerated("CURRENT_DATE")) @db.Date
  count   Int      @default(0)
  users   users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([user_id, day])
}

model trending_tags {
  id          String         @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tag         String
  category    feed_category?
  region      String?
  score       Decimal        @default(0) @db.Decimal(10, 4)
  vibe_count  Int            @default(0)
  velocity    Decimal        @default(0) @db.Decimal(8, 4)
  momentum    trend_momentum @default(rising)
  heat        Int            @default(50)
  headline    String?
  snapshot_at DateTime       @default(now()) @db.Timestamptz(6)

  @@index([category, heat(sort: Desc)], map: "idx_trending_tags_category")
  @@index([score(sort: Desc), snapshot_at(sort: Desc)], map: "idx_trending_tags_score")
}

model trust_signals {
  user_id         String   @id @db.Uuid
  trust_score     Decimal  @default(50) @db.Decimal(5, 2)
  spam_score      Decimal  @default(0) @db.Decimal(5, 2)
  bot_score       Decimal  @default(0) @db.Decimal(5, 2)
  report_count    Int      @default(0)
  warning_count   Int      @default(0)
  last_calculated DateTime @default(now()) @db.Timestamptz(6)
  updated_at      DateTime @default(now()) @db.Timestamptz(6)
  users           users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([trust_score(sort: Desc)], map: "idx_trust_signals_score")
}

model two_factor_challenges {
  id         String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id    String    @db.Uuid
  code       String
  expires_at DateTime  @db.Timestamptz(6)
  used_at    DateTime? @db.Timestamptz(6)
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model user_activity_log {
  id          String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id     String   @db.Uuid
  action      String
  entity_type String?
  entity_id   String?  @db.Uuid
  metadata    Json?    @default("{}")
  ip_address  String?  @db.Inet
  user_agent  String?
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  users       users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([action, created_at(sort: Desc)], map: "idx_user_activity_action")
  @@index([user_id, created_at(sort: Desc)], map: "idx_user_activity_user")
}

model user_badges {
  user_id    String   @db.Uuid
  badge_id   String   @db.Uuid
  awarded_at DateTime @default(now()) @db.Timestamptz(6)
  badges     badges   @relation(fields: [badge_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users      users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([user_id, badge_id])
}

model user_blocks {
  blocker_id                          String   @db.Uuid
  blocked_id                          String   @db.Uuid
  created_at                          DateTime @default(now()) @db.Timestamptz(6)
  users_user_blocks_blocked_idTousers users    @relation("user_blocks_blocked_idTousers", fields: [blocked_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users_user_blocks_blocker_idTousers users    @relation("user_blocks_blocker_idTousers", fields: [blocker_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([blocker_id, blocked_id])
  @@index([blocked_id], map: "idx_user_blocks_blocked")
  @@index([blocker_id], map: "idx_user_blocks_blocker")
}

model user_feature_flags {
  user_id       String        @db.Uuid
  flag_id       String        @db.Uuid
  enabled       Boolean
  created_at    DateTime      @default(now()) @db.Timestamptz(6)
  feature_flags feature_flags @relation(fields: [flag_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users         users         @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([user_id, flag_id])
}

model user_has_permissions {
  user_id                                       String      @db.Uuid
  permission_id                                 String      @db.Uuid
  scope_type                                    String      @default("")
  scope_id                                      String      @default("")
  assigned_by                                   String?     @db.Uuid
  assigned_at                                   DateTime    @default(now()) @db.Timestamptz(6)
  expires_at                                    DateTime?   @db.Timestamptz(6)
  users_user_has_permissions_assigned_byTousers users?      @relation("user_has_permissions_assigned_byTousers", fields: [assigned_by], references: [id], onUpdate: NoAction)
  permissions                                   permissions @relation(fields: [permission_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users_user_has_permissions_user_idTousers     users       @relation("user_has_permissions_user_idTousers", fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([user_id, permission_id, scope_type, scope_id])
  @@index([expires_at], map: "idx_uhp_expiry", where: raw("(expires_at IS NOT NULL)"))
  @@index([permission_id], map: "idx_uhp_permission")
  @@index([user_id, scope_type, scope_id], map: "idx_uhp_user")
}

model user_has_roles {
  user_id                                 String    @db.Uuid
  role_id                                 String    @db.Uuid
  scope_type                              String    @default("")
  scope_id                                String    @default("")
  assigned_by                             String?   @db.Uuid
  assigned_at                             DateTime  @default(now()) @db.Timestamptz(6)
  expires_at                              DateTime? @db.Timestamptz(6)
  users_user_has_roles_assigned_byTousers users?    @relation("user_has_roles_assigned_byTousers", fields: [assigned_by], references: [id], onUpdate: NoAction)
  roles                                   roles     @relation(fields: [role_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users_user_has_roles_user_idTousers     users     @relation("user_has_roles_user_idTousers", fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([user_id, role_id, scope_type, scope_id])
  @@index([expires_at], map: "idx_uhr_expiry", where: raw("(expires_at IS NOT NULL)"))
  @@index([role_id], map: "idx_uhr_role")
  @@index([user_id, scope_type, scope_id], map: "idx_uhr_user")
}

model user_mutes {
  muter_id                         String   @db.Uuid
  muted_id                         String   @db.Uuid
  created_at                       DateTime @default(now()) @db.Timestamptz(6)
  users_user_mutes_muted_idTousers users    @relation("user_mutes_muted_idTousers", fields: [muted_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users_user_mutes_muter_idTousers users    @relation("user_mutes_muter_idTousers", fields: [muter_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([muter_id, muted_id])
  @@index([muter_id], map: "idx_user_mutes_muter")
}

model user_topic_memberships {
  user_id        String         @db.Uuid
  topic_id       String         @db.Uuid
  joined_at      DateTime       @default(now()) @db.Timestamptz(6)
  explore_topics explore_topics @relation(fields: [topic_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users          users          @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([user_id, topic_id])
}

