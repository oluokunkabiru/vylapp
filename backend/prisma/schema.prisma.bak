model vibe_bookmarks {
  user_id    String   @db.Uuid
  vibe_id    String   @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz(6)
  users      users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  vibes      vibes    @relation(fields: [vibe_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([user_id, vibe_id])
  @@index([user_id], map: "idx_vibe_bookmarks_user")
}

model vibe_event_reminders {
  user_id    String   @db.Uuid
  vibe_id    String   @db.Uuid
  reminded   Boolean  @default(false)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  users      users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  vibes      vibes    @relation(fields: [vibe_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([user_id, vibe_id])
}

model vibe_likes {
  user_id    String   @db.Uuid
  vibe_id    String   @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz(6)
  users      users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  vibes      vibes    @relation(fields: [vibe_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([user_id, vibe_id])
  @@index([user_id], map: "idx_vibe_likes_user")
  @@index([vibe_id], map: "idx_vibe_likes_vibe")
}

model vibe_media {
  id            String     @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  vibe_id       String     @db.Uuid
  media_type    media_type
  url           String
  thumbnail_url String?
  width         Int?
  height        Int?
  duration_ms   Int?
  size_bytes    BigInt?
  alt_text      String?
  sort_order    Int        @default(0)
  created_at    DateTime   @default(now()) @db.Timestamptz(6)
  vibes         vibes      @relation(fields: [vibe_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model vibe_poll_options {
  id              String            @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  poll_id         String            @db.Uuid
  label           String
  votes_count     Int               @default(0)
  sort_order      Int               @default(0)
  vibe_polls      vibe_polls        @relation(fields: [poll_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  vibe_poll_votes vibe_poll_votes[]
}

model vibe_poll_votes {
  user_id           String            @db.Uuid
  poll_id           String            @db.Uuid
  option_id         String            @db.Uuid
  created_at        DateTime          @default(now()) @db.Timestamptz(6)
  vibe_poll_options vibe_poll_options @relation(fields: [option_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  vibe_polls        vibe_polls        @relation(fields: [poll_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users             users             @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([user_id, poll_id])
}

model vibe_polls {
  id                String              @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  vibe_id           String              @unique @db.Uuid
  question          String
  closes_at         DateTime            @db.Timestamptz(6)
  total_votes       Int                 @default(0)
  created_at        DateTime            @default(now()) @db.Timestamptz(6)
  vibe_poll_options vibe_poll_options[]
  vibe_poll_votes   vibe_poll_votes[]
  vibes             vibes               @relation(fields: [vibe_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model vibe_reposts {
  user_id    String   @db.Uuid
  vibe_id    String   @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz(6)
  users      users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  vibes      vibes    @relation(fields: [vibe_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([user_id, vibe_id])
  @@index([vibe_id], map: "idx_vibe_reposts_vibe")
}

model vibe_translations {
  vibe_id     String   @db.Uuid
  target_lang String
  content     String
  method      String
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  vibes       vibes    @relation(fields: [vibe_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([vibe_id, target_lang])
}

model vibe_views {
  id         String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  vibe_id    String   @db.Uuid
  viewer_id  String?  @db.Uuid
  session_id String?
  source     String?
  viewed_at  DateTime @default(now()) @db.Timestamptz(6)
  vibes      vibes    @relation(fields: [vibe_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users      users?   @relation(fields: [viewer_id], references: [id], onUpdate: NoAction)

  @@index([vibe_id, viewed_at(sort: Desc)], map: "idx_vibe_views_vibe")
  @@index([viewer_id], map: "idx_vibe_views_viewer", where: raw("(viewer_id IS NOT NULL)"))
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model has constraints using non-default deferring rules and requires additional setup for migrations. Visit https://pris.ly/d/constraint-deferring for more info.
model vibes {
  id                                      String                 @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id                                 String                 @db.Uuid
  content                                 String
  content_html                            String?
  category                                feed_category          @default(GENERAL)
  tags                                    String[]               @default([])
  language                                String?                @default("en")
  reply_to                                String?                @db.Uuid
  repost_of                               String?                @db.Uuid
  quote_of                                String?                @db.Uuid
  thread_root_id                          String?                @db.Uuid
  thread_depth                            Int                    @default(0)
  is_close_friends                        Boolean                @default(false)
  is_paid_content                         Boolean                @default(false)
  paid_content_price_usd                  Decimal?               @db.Decimal(8, 2)
  event_title                             String?
  event_time                              String?
  event_space_id                          String?                @db.Uuid
  event_reminded_count                    Int                    @default(0)
  event_interested_count                  Int                    @default(0)
  likes_count                             Int                    @default(0)
  reposts_count                           Int                    @default(0)
  replies_count                           Int                    @default(0)
  quotes_count                            Int                    @default(0)
  views_count                             Int                    @default(0)
  shares_count                            Int                    @default(0)
  bookmarks_count                         Int                    @default(0)
  is_autopilot                            Boolean                @default(false)
  autopilot_run_id                        String?                @db.Uuid
  autopilot_topic                         String?
  autopilot_trend_heat                    Int?
  autopilot_momentum                      trend_momentum?
  impact_badge                            String?
  is_sensitive                            Boolean                @default(false)
  is_deleted                              Boolean                @default(false)
  deleted_at                              DateTime?              @db.Timestamptz(6)
  moderation_note                         String?
  created_at                              DateTime               @default(now()) @db.Timestamptz(6)
  updated_at                              DateTime               @default(now()) @db.Timestamptz(6)
  scheduled_at                            DateTime?              @db.Timestamptz(6)
  autopilot_comments                      autopilot_comments[]
  autopilot_topics                        autopilot_topics[]
  feed_items                              feed_items[]
  messages                                messages[]
  moderation_actions                      moderation_actions[]
  notifications                           notifications[]
  reports                                 reports[]
  super_vibes                             super_vibes[]
  vibe_bookmarks                          vibe_bookmarks[]
  vibe_event_reminders                    vibe_event_reminders[]
  vibe_likes                              vibe_likes[]
  vibe_media                              vibe_media[]
  vibe_polls                              vibe_polls?
  vibe_reposts                            vibe_reposts[]
  vibe_translations                       vibe_translations[]
  vibe_views                              vibe_views[]
  vibes_vibes_event_space_idTovibes       vibes?                 @relation("vibes_event_space_idTovibes", fields: [event_space_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_vibes_event_space")
  other_vibes_vibes_event_space_idTovibes vibes[]                @relation("vibes_event_space_idTovibes")
  vibes_vibes_quote_ofTovibes             vibes?                 @relation("vibes_quote_ofTovibes", fields: [quote_of], references: [id], onUpdate: NoAction)
  other_vibes_vibes_quote_ofTovibes       vibes[]                @relation("vibes_quote_ofTovibes")
  vibes_vibes_reply_toTovibes             vibes?                 @relation("vibes_reply_toTovibes", fields: [reply_to], references: [id], onUpdate: NoAction)
  other_vibes_vibes_reply_toTovibes       vibes[]                @relation("vibes_reply_toTovibes")
  vibes_vibes_repost_ofTovibes            vibes?                 @relation("vibes_repost_ofTovibes", fields: [repost_of], references: [id], onUpdate: NoAction)
  other_vibes_vibes_repost_ofTovibes      vibes[]                @relation("vibes_repost_ofTovibes")
  vibes_vibes_thread_root_idTovibes       vibes?                 @relation("vibes_thread_root_idTovibes", fields: [thread_root_id], references: [id], onUpdate: NoAction)
  other_vibes_vibes_thread_root_idTovibes vibes[]                @relation("vibes_thread_root_idTovibes")
  users                                   users                  @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([is_autopilot, created_at(sort: Desc)], map: "idx_vibes_autopilot", where: raw("(is_autopilot = true)"))
  @@index([category, created_at(sort: Desc)], map: "idx_vibes_category", where: raw("(is_deleted = false)"))
  @@index([created_at(sort: Desc)], map: "idx_vibes_created", where: raw("(is_deleted = false)"))
  @@index([category, created_at(sort: Desc), likes_count(sort: Desc)], map: "idx_vibes_feed_cat", where: raw("(is_deleted = false)"))
  @@index([reply_to], map: "idx_vibes_reply_to", where: raw("(reply_to IS NOT NULL)"))
  @@index([scheduled_at], map: "idx_vibes_scheduled", where: raw("((scheduled_at IS NOT NULL) AND (is_deleted = false))"))
  @@index([tags], map: "idx_vibes_tags", type: Gin)
  @@index([thread_root_id], map: "idx_vibes_thread_root", where: raw("(thread_root_id IS NOT NULL)"))
  @@index([likes_count(sort: Desc), reposts_count(sort: Desc), created_at(sort: Desc)], map: "idx_vibes_trending", where: raw("(is_deleted = false)"))
  @@index([user_id, created_at(sort: Desc)], map: "idx_vibes_user")
}

model webhooks {
  id         String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id    String    @db.Uuid
  url        String
  events     String[]  @default([])
  secret     String
  active     Boolean   @default(true)
  last_fired DateTime? @db.Timestamptz(6)
  fail_count Int       @default(0)
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

