generator client {
  provider        = "prisma-client-js"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model admin_audit_log {
  id          String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  admin_id    String   @db.Uuid
  action      String
  target_type String?
  target_id   String?  @db.Uuid
  before_data Json?
  after_data  Json?
  ip_address  String?  @db.Inet
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  users       users    @relation(fields: [admin_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([created_at(sort: Desc)], map: "idx_admin_audit_created")
}

model app_config {
  key         String   @id
  value       Json
  description String?
  updated_by  String?  @db.Uuid
  updated_at  DateTime @default(now()) @db.Timestamptz(6)
  users       users?   @relation(fields: [updated_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model autopilot_comments {
  id                 String         @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  run_id             String         @db.Uuid
  vibe_id            String         @db.Uuid
  commenter_viber_id String
  commenter_name     String
  content            String
  sentiment          String         @default("positive")
  simulated_likes    Int            @default(0)
  auto_replied       Boolean        @default(false)
  reply_content      String?
  created_at         DateTime       @default(now()) @db.Timestamptz(6)
  autopilot_runs     autopilot_runs @relation(fields: [run_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  vibes              vibes          @relation(fields: [vibe_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([vibe_id], map: "idx_autopilot_comments_vibe")
}

model autopilot_configs {
  user_id            String   @id @db.Uuid
  enabled            Boolean  @default(false)
  auto_post          Boolean  @default(true)
  auto_engage        Boolean  @default(true)
  auto_reply         Boolean  @default(true)
  post_interval_secs Int      @default(6)
  reply_delay_secs   Int      @default(3)
  max_posts_per_run  Int      @default(8)
  active_categories  String[] @default(["tech", "global", "creative", "human", "spaces"])
  persona_viber_id   String?
  created_at         DateTime @default(now()) @db.Timestamptz(6)
  updated_at         DateTime @default(now()) @db.Timestamptz(6)
  users              users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model autopilot_runs {
  id                 String               @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id            String               @db.Uuid
  status             autopilot_status     @default(idle)
  posts_generated    Int                  @default(0)
  replies_generated  Int                  @default(0)
  topics_scanned     Int                  @default(0)
  total_likes_est    Int                  @default(0)
  total_reposts_est  Int                  @default(0)
  error_message      String?
  started_at         DateTime             @default(now()) @db.Timestamptz(6)
  completed_at       DateTime?            @db.Timestamptz(6)
  autopilot_comments autopilot_comments[]
  users              users                @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  autopilot_topics   autopilot_topics[]

  @@index([user_id, started_at(sort: Desc)], map: "idx_autopilot_runs_user")
}

model autopilot_schedules {
  id              String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id         String    @db.Uuid
  cron_expression String
  preset_name     String    @default("peak")
  enabled         Boolean   @default(true)
  last_run_at     DateTime? @db.Timestamptz(6)
  next_run_at     DateTime? @db.Timestamptz(6)
  created_at      DateTime  @default(now()) @db.Timestamptz(6)
  updated_at      DateTime  @default(now()) @db.Timestamptz(6)
  users           users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([next_run_at], map: "idx_autopilot_schedules_next", where: raw("(enabled = true)"))
  @@index([user_id], map: "idx_autopilot_schedules_user", where: raw("(enabled = true)"))
}

model autopilot_topics {
  id             String         @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  run_id         String         @db.Uuid
  category       feed_category
  topic          String
  headline       String
  heat           Int            @default(50)
  region         String         @default("Global")
  momentum       trend_momentum @default(rising)
  hashtags       String[]       @default([])
  posted         Boolean        @default(false)
  vibe_id        String?        @db.Uuid
  created_at     DateTime       @default(now()) @db.Timestamptz(6)
  autopilot_runs autopilot_runs @relation(fields: [run_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  vibes          vibes?         @relation(fields: [vibe_id], references: [id], onUpdate: NoAction)

  @@index([run_id], map: "idx_autopilot_topics_run")
}

model badges {
  id          String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  key         String        @unique
  label       String
  description String?
  icon        String?
  color       String?
  criteria    Json          @default("{}")
  created_at  DateTime      @default(now()) @db.Timestamptz(6)
  user_badges user_badges[]
}

model certificates {
  id            String    @id
  user_id       String    @db.Uuid
  course_id     String    @db.Uuid
  course_title  String
  educator_name String
  issued_at     DateTime  @default(now()) @db.Timestamptz(6)
  revoked_at    DateTime? @db.Timestamptz(6)
  revoke_reason String?
  metadata      Json      @default("{}")
  courses       courses   @relation(fields: [course_id], references: [id], onUpdate: NoAction)
  users         users     @relation(fields: [user_id], references: [id], onUpdate: NoAction)

  @@unique([user_id, course_id])
  @@index([user_id], map: "idx_certificates_user")
}

model checkpoint_responses {
  id                    String                @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id               String                @db.Uuid
  checkpoint_id         String                @db.Uuid
  selected_option       String
  is_correct            Boolean
  points_earned         Int                   @default(0)
  responded_at          DateTime              @default(now()) @db.Timestamptz(6)
  knowledge_checkpoints knowledge_checkpoints @relation(fields: [checkpoint_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users                 users                 @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, checkpoint_id])
  @@index([checkpoint_id], map: "idx_responses_checkpoint")
  @@index([user_id], map: "idx_responses_user")
}

model close_connections {
  user_id                                  String   @db.Uuid
  friend_id                                String   @db.Uuid
  created_at                               DateTime @default(now()) @db.Timestamptz(6)
  users_close_connections_friend_idTousers users    @relation("close_connections_friend_idTousers", fields: [friend_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users_close_connections_user_idTousers   users    @relation("close_connections_user_idTousers", fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([user_id, friend_id])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model community_memberships {
  user_id                                        String           @db.Uuid
  category_id                                    String           @db.Uuid
  status                                         String           @default("pending")
  requested_at                                   DateTime         @default(now()) @db.Timestamptz(6)
  resolved_at                                    DateTime?        @db.Timestamptz(6)
  resolved_by                                    String?          @db.Uuid
  forum_categories                               forum_categories @relation(fields: [category_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users_community_memberships_resolved_byTousers users?           @relation("community_memberships_resolved_byTousers", fields: [resolved_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users_community_memberships_user_idTousers     users            @relation("community_memberships_user_idTousers", fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([user_id, category_id])
  @@index([category_id, status], map: "idx_memberships_category")
}

model community_moderators {
  id                                            String           @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  category_id                                   String           @db.Uuid
  user_id                                       String           @db.Uuid
  role                                          forum_mod_role   @default(moderator)
  assigned_by                                   String           @db.Uuid
  permissions                                   Json             @default("{\"pin\": false, \"lock\": true, \"warn\": true, \"remove\": true}")
  assigned_at                                   DateTime         @default(now()) @db.Timestamptz(6)
  expires_at                                    DateTime?        @db.Timestamptz(6)
  users_community_moderators_assigned_byTousers users            @relation("community_moderators_assigned_byTousers", fields: [assigned_by], references: [id], onUpdate: NoAction)
  forum_categories                              forum_categories @relation(fields: [category_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users_community_moderators_user_idTousers     users            @relation("community_moderators_user_idTousers", fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([category_id, user_id])
  @@index([category_id], map: "idx_mod_category")
  @@index([user_id], map: "idx_mod_user")
}

model connection_requests {
  id                                            String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  requester_id                                  String    @db.Uuid
  target_id                                     String    @db.Uuid
  message                                       String?
  status                                        String    @default("pending")
  created_at                                    DateTime  @default(now()) @db.Timestamptz(6)
  resolved_at                                   DateTime? @db.Timestamptz(6)
  users_connection_requests_requester_idTousers users     @relation("connection_requests_requester_idTousers", fields: [requester_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users_connection_requests_target_idTousers    users     @relation("connection_requests_target_idTousers", fields: [target_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([requester_id, target_id])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model connections {
  follower_id                           String   @db.Uuid
  following_id                          String   @db.Uuid
  notify_posts                          Boolean  @default(true)
  notify_spaces                         Boolean  @default(true)
  created_at                            DateTime @default(now()) @db.Timestamptz(6)
  users_connections_follower_idTousers  users    @relation("connections_follower_idTousers", fields: [follower_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users_connections_following_idTousers users    @relation("connections_following_idTousers", fields: [following_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([follower_id, following_id])
  @@index([follower_id], map: "idx_connections_follower")
  @@index([following_id], map: "idx_connections_following")
}

model content_filters {
  id         String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  phrase     String
  action     String   @default("flag")
  category   String?
  active     Boolean  @default(true)
  created_at DateTime @default(now()) @db.Timestamptz(6)
}

model conversation_members {
  conversation_id String        @db.Uuid
  user_id         String        @db.Uuid
  role            String        @default("member")
  nickname        String?
  unread_count    Int           @default(0)
  last_read_at    DateTime?     @db.Timestamptz(6)
  muted_until     DateTime?     @db.Timestamptz(6)
  pinned          Boolean       @default(false)
  joined_at       DateTime      @default(now()) @db.Timestamptz(6)
  left_at         DateTime?     @db.Timestamptz(6)
  conversations   conversations @relation(fields: [conversation_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users           users         @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([conversation_id, user_id])
  @@index([conversation_id], map: "idx_conv_members_conv")
  @@index([user_id, last_read_at(sort: Desc)], map: "idx_conv_members_user")
}

model conversations {
  id                   String                 @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  type                 conversation_type      @default(dm)
  name                 String?
  description          String?
  color                String?
  avatar_url           String?
  created_by           String?                @db.Uuid
  space_id             String?                @db.Uuid
  last_message_id      String?                @db.Uuid
  last_message_at      DateTime?              @db.Timestamptz(6)
  last_message_preview String?
  is_announcement      Boolean                @default(false)
  created_at           DateTime               @default(now()) @db.Timestamptz(6)
  updated_at           DateTime               @default(now()) @db.Timestamptz(6)
  conversation_members conversation_members[]
  users                users?                 @relation(fields: [created_by], references: [id], onUpdate: NoAction)
  spaces               spaces?                @relation(fields: [space_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  messages             messages[]
  notifications        notifications[]

  @@index([updated_at(sort: Desc)], map: "idx_conv_updated")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model course_enrolments {
  id                       String           @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id                  String           @db.Uuid
  course_id                String           @db.Uuid
  status                   enrolment_status @default(active)
  progress_pct             Int              @default(0)
  lessons_done             Int              @default(0)
  stripe_payment_intent_id String?
  amount_paid_usd          Decimal          @default(0) @db.Decimal(8, 2)
  enrolled_at              DateTime         @default(now()) @db.Timestamptz(6)
  completed_at             DateTime?        @db.Timestamptz(6)
  expires_at               DateTime?        @db.Timestamptz(6)
  courses                  courses          @relation(fields: [course_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users                    users            @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, course_id])
  @@index([course_id, status], map: "idx_enrolments_course")
  @@index([user_id, status], map: "idx_enrolments_user")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model course_ratings {
  id         String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id    String   @db.Uuid
  course_id  String   @db.Uuid
  rating     Int
  review     String?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)
  courses    courses  @relation(fields: [course_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users      users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, course_id])
  @@index([course_id], map: "idx_ratings_course")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model courses {
  id                 String               @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  educator_id        String               @db.Uuid
  title              String
  description        String
  category           String
  language           String               @default("en")
  difficulty         String               @default("beginner")
  status             course_status        @default(draft)
  is_free            Boolean              @default(true)
  price_usd          Decimal              @default(0) @db.Decimal(8, 2)
  cover_image_url    String?
  preview_video_url  String?
  estimated_hours    Decimal?             @db.Decimal(4, 1)
  tags               String[]             @default([])
  enrolment_count    Int                  @default(0)
  total_lessons      Int                  @default(0)
  avg_rating         Decimal              @default(0) @db.Decimal(3, 2)
  stripe_product_id  String?
  published_at       DateTime?            @db.Timestamptz(6)
  created_at         DateTime             @default(now()) @db.Timestamptz(6)
  updated_at         DateTime             @default(now()) @db.Timestamptz(6)
  certificates       certificates[]
  course_enrolments  course_enrolments[]
  course_ratings     course_ratings[]
  educator_profiles  educator_profiles    @relation(fields: [educator_id], references: [id], onUpdate: NoAction)
  lesson_completions lesson_completions[]
  lessons            lessons[]
  path_courses       path_courses[]

  @@index([category], map: "idx_courses_category")
  @@index([educator_id], map: "idx_courses_educator")
  @@index([is_free], map: "idx_courses_is_free")
  @@index([language], map: "idx_courses_language")
  @@index([status], map: "idx_courses_status")
  @@index([tags], map: "idx_courses_tags", type: Gin)
}

model creator_analytics_daily {
  id               String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  creator_id       String   @db.Uuid
  date             DateTime @db.Date
  new_followers    Int      @default(0)
  lost_followers   Int      @default(0)
  profile_views    Int      @default(0)
  vibe_impressions Int      @default(0)
  vibe_likes       Int      @default(0)
  vibe_reposts     Int      @default(0)
  space_listeners  Int      @default(0)
  space_minutes    Int      @default(0)
  earnings_usd     Decimal  @default(0) @db.Decimal(10, 2)
  new_subscribers  Int      @default(0)
  created_at       DateTime @default(now()) @db.Timestamptz(6)
  users            users    @relation(fields: [creator_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([creator_id, date])
  @@index([creator_id, date(sort: Desc)], map: "idx_creator_analytics_creator")
}

model creator_payouts {
  id                String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  creator_id        String        @db.Uuid
  amount_usd        Decimal       @db.Decimal(10, 2)
  stripe_payout_id  String?
  stripe_account_id String?
  status            payout_status @default(pending)
  period_start      DateTime      @db.Date
  period_end        DateTime      @db.Date
  paid_at           DateTime?     @db.Timestamptz(6)
  failed_at         DateTime?     @db.Timestamptz(6)
  failure_reason    String?
  created_at        DateTime      @default(now()) @db.Timestamptz(6)
  users             users         @relation(fields: [creator_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([creator_id, status], map: "idx_creator_payouts_creator")
}

model creator_profiles {
  user_id             String   @id @db.Uuid
  bio_extended        String?
  categories          String[] @default([])
  social_links        Json?    @default("{}")
  stripe_account_id   String?  @unique
  stripe_onboarded    Boolean  @default(false)
  payout_schedule     String?  @default("weekly")
  minimum_payout_usd  Decimal? @default(50) @db.Decimal(8, 2)
  total_earned_usd    Decimal  @default(0) @db.Decimal(12, 2)
  total_withdrawn_usd Decimal  @default(0) @db.Decimal(12, 2)
  pending_balance_usd Decimal  @default(0) @db.Decimal(12, 2)
  subscriber_count    Int      @default(0)
  created_at          DateTime @default(now()) @db.Timestamptz(6)
  updated_at          DateTime @default(now()) @db.Timestamptz(6)
  users               users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model creator_subscription_tiers {
  id                    String                  @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  creator_id            String                  @db.Uuid
  name                  String
  description           String?
  price_usd             Decimal                 @db.Decimal(8, 2)
  billing_period        String                  @default("monthly")
  perks                 String[]                @default([])
  max_subscribers       Int?
  active                Boolean                 @default(true)
  sort_order            Int                     @default(0)
  created_at            DateTime                @default(now()) @db.Timestamptz(6)
  updated_at            DateTime                @default(now()) @db.Timestamptz(6)
  users                 users                   @relation(fields: [creator_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  creator_subscriptions creator_subscriptions[]
}

model creator_subscriptions {
  id                                               String                     @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  subscriber_id                                    String                     @db.Uuid
  creator_id                                       String                     @db.Uuid
  tier_id                                          String                     @db.Uuid
  status                                           subscription_status        @default(active)
  price_usd                                        Decimal                    @db.Decimal(8, 2)
  stripe_subscription_id                           String?                    @unique
  started_at                                       DateTime                   @default(now()) @db.Timestamptz(6)
  current_period_end                               DateTime?                  @db.Timestamptz(6)
  cancelled_at                                     DateTime?                  @db.Timestamptz(6)
  created_at                                       DateTime                   @default(now()) @db.Timestamptz(6)
  users_creator_subscriptions_creator_idTousers    users                      @relation("creator_subscriptions_creator_idTousers", fields: [creator_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users_creator_subscriptions_subscriber_idTousers users                      @relation("creator_subscriptions_subscriber_idTousers", fields: [subscriber_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  creator_subscription_tiers                       creator_subscription_tiers @relation(fields: [tier_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([subscriber_id, creator_id])
  @@index([creator_id, status], map: "idx_creator_subs_creator")
  @@index([subscriber_id], map: "idx_creator_subs_subscriber")
}

model digital_product_purchases {
  id                       String           @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  product_id               String           @db.Uuid
  buyer_id                 String           @db.Uuid
  price_usd                Decimal          @db.Decimal(8, 2)
  platform_fee_usd         Decimal          @db.Decimal(8, 2)
  creator_net_usd          Decimal          @db.Decimal(8, 2)
  stripe_payment_intent_id String?
  download_count           Int              @default(0)
  max_downloads            Int              @default(5)
  expires_at               DateTime?        @db.Timestamptz(6)
  created_at               DateTime         @default(now()) @db.Timestamptz(6)
  users                    users            @relation(fields: [buyer_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  digital_products         digital_products @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([product_id, buyer_id])
}

model digital_products {
  id                        String                      @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  creator_id                String                      @db.Uuid
  title                     String
  description               String?
  preview_url               String?
  file_url                  String?
  file_type                 String?
  file_size_bytes           BigInt?
  price_usd                 Decimal                     @db.Decimal(8, 2)
  purchases_count           Int                         @default(0)
  revenue_total_usd         Decimal                     @default(0) @db.Decimal(12, 2)
  active                    Boolean                     @default(true)
  created_at                DateTime                    @default(now()) @db.Timestamptz(6)
  updated_at                DateTime                    @default(now()) @db.Timestamptz(6)
  digital_product_purchases digital_product_purchases[]
  users                     users                       @relation(fields: [creator_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([creator_id], map: "idx_digital_products_creator", where: raw("(active = true)"))
