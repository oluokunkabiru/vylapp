model forum_threads {
  id               String           @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  category_id      String           @db.Uuid
  author_id        String           @db.Uuid
  title            String
  body             String
  language         String           @default("en")
  status           thread_status    @default(pending)
  is_pinned        Boolean          @default(false)
  is_announcement  Boolean          @default(false)
  view_count       Int              @default(0)
  reply_count      Int              @default(0)
  vote_score       Int              @default(0)
  last_reply_at    DateTime?        @db.Timestamptz(6)
  tags             String[]         @default([])
  moderation_note  String?
  created_at       DateTime         @default(now()) @db.Timestamptz(6)
  updated_at       DateTime         @default(now()) @db.Timestamptz(6)
  users            users            @relation(fields: [author_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  forum_categories forum_categories @relation(fields: [category_id], references: [id], onUpdate: NoAction)
  forum_votes      forum_votes[]
  thread_replies   thread_replies[]
  thread_tags      thread_tags[]

  @@index([author_id], map: "idx_threads_author")
  @@index([category_id, status, is_pinned(sort: Desc), last_reply_at(sort: Desc)], map: "idx_threads_category")
  @@index([is_pinned], map: "idx_threads_pinned", where: raw("(is_pinned = true)"))
  @@index([status], map: "idx_threads_status")
  @@index([tags], map: "idx_threads_tags", type: Gin)
  @@index([vote_score(sort: Desc)], map: "idx_threads_vote_score")
}

