generator client {
  provider        = "prisma-client-js"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes", "postgresqlExtensions"]
}

// uuid-ossp/pg_trgm/unaccent/citext are structurally required — uuid_generate_v4()
// defaults and @db.Citext columns depend on them. pgcrypto/pg_stat_statements from
// the original schema.sql are deliberately left out: neither is queried anywhere
// in the app, and pg_stat_statements specifically needs shared_preload_libraries
// set at the Postgres server level — a managed host that hasn't preloaded it would
// fail `CREATE EXTENSION` for zero functional benefit.
datasource db {
  provider   = "postgresql"
  extensions = [uuidOssp(map: "uuid-ossp"), pgTrgm(map: "pg_trgm"), unaccent, citext]
}

model AdminAuditLog {
  id         String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  adminId    String   @map("admin_id") @db.Uuid
  action     String
  targetType String?  @map("target_type")
  targetId   String?  @map("target_id") @db.Uuid
  beforeData Json?    @map("before_data")
  afterData  Json?    @map("after_data")
  ipAddress  String?  @map("ip_address") @db.Inet
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  users      Users    @relation(fields: [adminId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([createdAt(sort: Desc)], map: "idx_admin_audit_created")
  @@map("admin_audit_log")
}

model AppConfig {
  key         String   @id
  value       Json
  description String?
  updatedBy   String?  @map("updated_by") @db.Uuid
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  users       Users?   @relation(fields: [updatedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("app_config")
}

model AutopilotComments {
  id               String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  runId            String        @map("run_id") @db.Uuid
  vibeId           String        @map("vibe_id") @db.Uuid
  commenterViberId String        @map("commenter_viber_id")
  commenterName    String        @map("commenter_name")
  content          String
  sentiment        String        @default("positive")
  simulatedLikes   Int           @default(0) @map("simulated_likes")
  autoReplied      Boolean       @default(false) @map("auto_replied")
  replyContent     String?       @map("reply_content")
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  autopilotRuns    AutopilotRuns @relation(fields: [runId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  vibes            Vibes         @relation(fields: [vibeId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([vibeId], map: "idx_autopilot_comments_vibe")
  @@map("autopilot_comments")
}

model AutopilotConfigs {
  userId           String   @id @map("user_id") @db.Uuid
  enabled          Boolean  @default(false)
  autoPost         Boolean  @default(true) @map("auto_post")
  autoEngage       Boolean  @default(true) @map("auto_engage")
  autoReply        Boolean  @default(true) @map("auto_reply")
  postIntervalSecs Int      @default(6) @map("post_interval_secs")
  replyDelaySecs   Int      @default(3) @map("reply_delay_secs")
  maxPostsPerRun   Int      @default(8) @map("max_posts_per_run")
  activeCategories String[] @default(["tech", "global", "creative", "human", "spaces"]) @map("active_categories")
  personaViberId   String?  @map("persona_viber_id")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  users            Users    @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("autopilot_configs")
}

model AutopilotRuns {
  id                String              @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId            String              @map("user_id") @db.Uuid
  status            AutopilotStatus     @default(idle)
  postsGenerated    Int                 @default(0) @map("posts_generated")
  repliesGenerated  Int                 @default(0) @map("replies_generated")
  topicsScanned     Int                 @default(0) @map("topics_scanned")
  totalLikesEst     Int                 @default(0) @map("total_likes_est")
  totalRepostsEst   Int                 @default(0) @map("total_reposts_est")
  errorMessage      String?             @map("error_message")
  startedAt         DateTime            @default(now()) @map("started_at") @db.Timestamptz(6)
  completedAt       DateTime?           @map("completed_at") @db.Timestamptz(6)
  autopilotComments AutopilotComments[]
  users             Users               @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  autopilotTopics   AutopilotTopics[]

  @@index([userId, startedAt(sort: Desc)], map: "idx_autopilot_runs_user")
  @@map("autopilot_runs")
}

model AutopilotSchedules {
  id             String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  cronExpression String    @map("cron_expression")
  presetName     String    @default("peak") @map("preset_name")
  enabled        Boolean   @default(true)
  lastRunAt      DateTime? @map("last_run_at") @db.Timestamptz(6)
  nextRunAt      DateTime? @map("next_run_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  users          Users     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([nextRunAt], map: "idx_autopilot_schedules_next", where: raw("(enabled = true)"))
  @@index([userId], map: "idx_autopilot_schedules_user", where: raw("(enabled = true)"))
  @@map("autopilot_schedules")
}

model AutopilotTopics {
  id            String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  runId         String        @map("run_id") @db.Uuid
  category      FeedCategory
  topic         String
  headline      String
  heat          Int           @default(50)
  region        String        @default("Global")
  momentum      TrendMomentum @default(rising)
  hashtags      String[]      @default([])
  posted        Boolean       @default(false)
  vibeId        String?       @map("vibe_id") @db.Uuid
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  autopilotRuns AutopilotRuns @relation(fields: [runId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  vibes         Vibes?        @relation(fields: [vibeId], references: [id], onUpdate: NoAction)

  @@index([runId], map: "idx_autopilot_topics_run")
  @@map("autopilot_topics")
}

model Badges {
  id          String       @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  key         String       @unique
  label       String
  description String?
  icon        String?
  color       String?
  criteria    Json         @default("{}")
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  userBadges  UserBadges[]

  @@map("badges")
}

model Certificates {
  id           String    @id
  userId       String    @map("user_id") @db.Uuid
  courseId     String    @map("course_id") @db.Uuid
  courseTitle  String    @map("course_title")
  educatorName String    @map("educator_name")
  issuedAt     DateTime  @default(now()) @map("issued_at") @db.Timestamptz(6)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokeReason String?   @map("revoke_reason")
  metadata     Json      @default("{}")
  courses      Courses   @relation(fields: [courseId], references: [id], onUpdate: NoAction)
  users        Users     @relation(fields: [userId], references: [id], onUpdate: NoAction)

  @@unique([userId, courseId])
  @@index([userId], map: "idx_certificates_user")
  @@map("certificates")
}

model CheckpointResponses {
  id                   String               @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId               String               @map("user_id") @db.Uuid
  checkpointId         String               @map("checkpoint_id") @db.Uuid
  selectedOption       String               @map("selected_option")
  isCorrect            Boolean              @map("is_correct")
  pointsEarned         Int                  @default(0) @map("points_earned")
  respondedAt          DateTime             @default(now()) @map("responded_at") @db.Timestamptz(6)
  knowledgeCheckpoints KnowledgeCheckpoints @relation(fields: [checkpointId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users                Users                @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, checkpointId])
  @@index([checkpointId], map: "idx_responses_checkpoint")
  @@index([userId], map: "idx_responses_user")
  @@map("checkpoint_responses")
}

model CloseConnections {
  userId                               String   @map("user_id") @db.Uuid
  friendId                             String   @map("friend_id") @db.Uuid
  createdAt                            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  usersCloseConnectionsFriendIdTousers Users    @relation("close_connections_friend_idTousers", fields: [friendId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  usersCloseConnectionsUserIdTousers   Users    @relation("close_connections_user_idTousers", fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([userId, friendId])
  @@map("close_connections")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model CommunityMemberships {
  userId                                     String          @map("user_id") @db.Uuid
  categoryId                                 String          @map("category_id") @db.Uuid
  status                                     String          @default("pending")
  requestedAt                                DateTime        @default(now()) @map("requested_at") @db.Timestamptz(6)
  resolvedAt                                 DateTime?       @map("resolved_at") @db.Timestamptz(6)
  resolvedBy                                 String?         @map("resolved_by") @db.Uuid
  forumCategories                            ForumCategories @relation(fields: [categoryId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  usersCommunityMembershipsResolvedByTousers Users?          @relation("community_memberships_resolved_byTousers", fields: [resolvedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  usersCommunityMembershipsUserIdTousers     Users           @relation("community_memberships_user_idTousers", fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([userId, categoryId])
  @@index([categoryId, status], map: "idx_memberships_category")
  @@map("community_memberships")
}

model CommunityModerators {
  id                                        String          @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  categoryId                                String          @map("category_id") @db.Uuid
  userId                                    String          @map("user_id") @db.Uuid
  role                                      ForumModRole    @default(moderator)
  assignedBy                                String          @map("assigned_by") @db.Uuid
  permissions                               Json            @default("{\"pin\": false, \"lock\": true, \"warn\": true, \"remove\": true}")
  assignedAt                                DateTime        @default(now()) @map("assigned_at") @db.Timestamptz(6)
  expiresAt                                 DateTime?       @map("expires_at") @db.Timestamptz(6)
  usersCommunityModeratorsAssignedByTousers Users           @relation("community_moderators_assigned_byTousers", fields: [assignedBy], references: [id], onUpdate: NoAction)
  forumCategories                           ForumCategories @relation(fields: [categoryId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  usersCommunityModeratorsUserIdTousers     Users           @relation("community_moderators_user_idTousers", fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([categoryId, userId])
  @@index([categoryId], map: "idx_mod_category")
  @@index([userId], map: "idx_mod_user")
  @@map("community_moderators")
}

model ConnectionRequests {
  id                                        String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  requesterId                               String    @map("requester_id") @db.Uuid
  targetId                                  String    @map("target_id") @db.Uuid
  message                                   String?
  status                                    String    @default("pending")
  createdAt                                 DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  resolvedAt                                DateTime? @map("resolved_at") @db.Timestamptz(6)
  usersConnectionRequestsRequesterIdTousers Users     @relation("connection_requests_requester_idTousers", fields: [requesterId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  usersConnectionRequestsTargetIdTousers    Users     @relation("connection_requests_target_idTousers", fields: [targetId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([requesterId, targetId])
  @@map("connection_requests")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model Connections {
  followerId                         String   @map("follower_id") @db.Uuid
  followingId                        String   @map("following_id") @db.Uuid
  notifyPosts                        Boolean  @default(true) @map("notify_posts")
  notifySpaces                       Boolean  @default(true) @map("notify_spaces")
  createdAt                          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  usersConnectionsFollowerIdTousers  Users    @relation("connections_follower_idTousers", fields: [followerId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  usersConnectionsFollowingIdTousers Users    @relation("connections_following_idTousers", fields: [followingId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([followerId, followingId])
  @@index([followerId], map: "idx_connections_follower")
  @@index([followingId], map: "idx_connections_following")
  @@map("connections")
}

model ContentFilters {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  phrase    String
  action    String   @default("flag")
  category  String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("content_filters")
}

model ConversationMembers {
  conversationId String        @map("conversation_id") @db.Uuid
  userId         String        @map("user_id") @db.Uuid
  role           String        @default("member")
  nickname       String?
  unreadCount    Int           @default(0) @map("unread_count")
  lastReadAt     DateTime?     @map("last_read_at") @db.Timestamptz(6)
  mutedUntil     DateTime?     @map("muted_until") @db.Timestamptz(6)
  pinned         Boolean       @default(false)
  joinedAt       DateTime      @default(now()) @map("joined_at") @db.Timestamptz(6)
  leftAt         DateTime?     @map("left_at") @db.Timestamptz(6)
  conversations  Conversations @relation(fields: [conversationId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users          Users         @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([conversationId, userId])
  @@index([conversationId], map: "idx_conv_members_conv")
  @@index([userId, lastReadAt(sort: Desc)], map: "idx_conv_members_user")
  @@map("conversation_members")
}

model Conversations {
  id                  String                @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  type                ConversationType      @default(dm)
  name                String?
  description         String?
  color               String?
  avatarUrl           String?               @map("avatar_url")
  createdBy           String?               @map("created_by") @db.Uuid
  spaceId             String?               @map("space_id") @db.Uuid
  lastMessageId       String?               @map("last_message_id") @db.Uuid
  lastMessageAt       DateTime?             @map("last_message_at") @db.Timestamptz(6)
  lastMessagePreview  String?               @map("last_message_preview")
  isAnnouncement      Boolean               @default(false) @map("is_announcement")
  createdAt           DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime              @default(now()) @map("updated_at") @db.Timestamptz(6)
  conversationMembers ConversationMembers[]
  users               Users?                @relation(fields: [createdBy], references: [id], onUpdate: NoAction)
  spaces              Spaces?               @relation(fields: [spaceId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  messages            Messages[]
  notifications       Notifications[]

  @@index([updatedAt(sort: Desc)], map: "idx_conv_updated")
  @@map("conversations")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model CourseEnrolments {
  id                    String          @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId                String          @map("user_id") @db.Uuid
  courseId              String          @map("course_id") @db.Uuid
  status                EnrolmentStatus @default(active)
  progressPct           Int             @default(0) @map("progress_pct")
  lessonsDone           Int             @default(0) @map("lessons_done")
  stripePaymentIntentId String?         @map("stripe_payment_intent_id")
  amountPaidUsd         Decimal         @default(0) @map("amount_paid_usd") @db.Decimal(8, 2)
  enrolledAt            DateTime        @default(now()) @map("enrolled_at") @db.Timestamptz(6)
  completedAt           DateTime?       @map("completed_at") @db.Timestamptz(6)
  expiresAt             DateTime?       @map("expires_at") @db.Timestamptz(6)
  courses               Courses         @relation(fields: [courseId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users                 Users           @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, courseId])
  @@index([courseId, status], map: "idx_enrolments_course")
  @@index([userId, status], map: "idx_enrolments_user")
  @@map("course_enrolments")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model CourseRatings {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  courseId  String   @map("course_id") @db.Uuid
  rating    Int
  review    String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  courses   Courses  @relation(fields: [courseId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users     Users    @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, courseId])
  @@index([courseId], map: "idx_ratings_course")
  @@map("course_ratings")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model Courses {
  id                String              @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  educatorId        String              @map("educator_id") @db.Uuid
  title             String
  description       String
  category          String
  language          String              @default("en")
  difficulty        String              @default("beginner")
  status            CourseStatus        @default(draft)
  isFree            Boolean             @default(true) @map("is_free")
  priceUsd          Decimal             @default(0) @map("price_usd") @db.Decimal(8, 2)
  coverImageUrl     String?             @map("cover_image_url")
  previewVideoUrl   String?             @map("preview_video_url")
  estimatedHours    Decimal?            @map("estimated_hours") @db.Decimal(4, 1)
  tags              String[]            @default([])
  enrolmentCount    Int                 @default(0) @map("enrolment_count")
  totalLessons      Int                 @default(0) @map("total_lessons")
  avgRating         Decimal             @default(0) @map("avg_rating") @db.Decimal(3, 2)
  stripeProductId   String?             @map("stripe_product_id")
  publishedAt       DateTime?           @map("published_at") @db.Timestamptz(6)
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime            @default(now()) @map("updated_at") @db.Timestamptz(6)
  certificates      Certificates[]
  courseEnrolments  CourseEnrolments[]
  courseRatings     CourseRatings[]
  educatorProfiles  EducatorProfiles    @relation(fields: [educatorId], references: [id], onUpdate: NoAction)
  lessonCompletions LessonCompletions[]
  lessons           Lessons[]
  pathCourses       PathCourses[]

  @@index([category], map: "idx_courses_category")
  @@index([educatorId], map: "idx_courses_educator")
  @@index([isFree], map: "idx_courses_is_free")
  @@index([language], map: "idx_courses_language")
  @@index([status], map: "idx_courses_status")
  @@index([tags], map: "idx_courses_tags", type: Gin)
  @@map("courses")
}

