{
  "name": "vylapp-backend",
  "version": "1.0.0",
  "description": "Vylapp platform backend — Express + PostgreSQL, full 81-table schema coverage",
  "type": "commonjs",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "postbuild": "cp -r src/generated dist/generated",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "migrate": "tsx src/db/migrate.js",
    "seed": "tsx src/db/seed.js",
    "setup": "npm run migrate && npm run seed"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "franc-min": "^6.2.0",
    "nodemailer": "^9.0.3",
    "pg": "^8.12.0",
    "prisma": "^7.8.0",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/node": "^26.1.1",
    "@types/nodemailer": "^8.0.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
