{
  "name": "vylapp-backend",
  "version": "1.0.0",
  "description": "Vylapp platform backend — Express + PostgreSQL, full 81-table schema coverage",
  "type": "commonjs",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node src/db/migrate.js",
    "seed": "node src/db/seed.js",
    "setup": "npm run migrate && npm run seed"
  },
  "engines": { "node": ">=18.0.0" },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "pg": "^8.12.0",
    "socket.io": "^4.7.5"
  }
}
