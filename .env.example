# ════════════════════════════════════════════════════════════════════════════
#  VYLAPP — ENVIRONMENT VARIABLE REFERENCE
#  Copy this file to .env in the backend/ directory.
#  Never commit a real .env file.
#  The mobile app is configured via firebase_options.dart (generated by
#  FlutterFire CLI). The frontend has no .env — all config is via
#  the Vite proxy at dev time and Nginx at production.
# ════════════════════════════════════════════════════════════════════════════

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://vylapp:yourpassword@localhost:5432/vylapp_dev
PG_SSL=false                             # set to true for production Fly.io Postgres

# ── JWT signing ───────────────────────────────────────────────────────────────
# Generate with: node -e "require('crypto').randomBytes(64).toString('hex')"
JWT_SECRET=REPLACE_WITH_64_BYTE_HEX
JWT_EXPIRES_IN=15m                       # access token lifetime
REFRESH_TOKEN_EXPIRES_IN=30d             # refresh token lifetime

# ── Server ────────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development                     # development | production
CLIENT_ORIGIN=http://localhost:5173      # CORS allow origin (web frontend)

# ── Anthropic API (translation + autopilot + content moderation) ──────────────
# Server-side only. Never expose this key to the browser or mobile client.
ANTHROPIC_API_KEY=sk-ant-REPLACE_WITH_YOUR_KEY

# ── Firebase Admin SDK (for server-side FCM token verification) ───────────────
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE\n-----END PRIVATE KEY-----\n"

# ── Stripe (creator payouts) ──────────────────────────────────────────────────
# These are placeholders — Stripe Connect is schema-only. Not yet wired to live transfers.
STRIPE_SECRET_KEY=sk_test_REPLACE
STRIPE_WEBHOOK_SECRET=whsec_REPLACE
STRIPE_CONNECT_CLIENT_ID=ca_REPLACE      # for OAuth-based onboarding

# ── Email (transactional — not yet implemented) ───────────────────────────────
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_USER=resend
# SMTP_PASS=re_REPLACE
# SMTP_FROM=hello@vylapp.com

# ── LiveKit (Spaces audio) ────────────────────────────────────────────────────
LIVEKIT_HOST=wss://your-livekit-instance.livekit.cloud
LIVEKIT_API_KEY=REPLACE
LIVEKIT_API_SECRET=REPLACE

# ── Storage (media uploads — not yet implemented) ─────────────────────────────
# CDN_PROVIDER=cloudflare_r2            # cloudflare_r2 | aws_s3 | supabase
# S3_BUCKET=vylapp-media
# S3_REGION=af-south-1                  # Cape Town for African market latency
# S3_ACCESS_KEY=REPLACE
# S3_SECRET_KEY=REPLACE

# ── SECURITY FLAGS (do not change in development) ─────────────────────────────
RATE_LIMIT_ENABLED=true
RBAC_CACHE_TTL_SECONDS=300              # 5-minute permission cache TTL
MULTILINGUAL_MODERATION=true            # enables Claude API layer 2 moderation
